<h1>Minhas categorias</h1>

<%= link_to "Nova categoria", new_category_path %>

<h2>Receitas</h2>

<% if @receitas.any? %>
  <ul>
    <% @receitas.each do |category| %>
      <li>
        <%= category.name %>
        <%= link_to "Editar", edit_category_path(category) %>
        <%= button_to "Excluir", category_path(category), method: :delete, data: { turbo_confirm: "Tem certeza?" } %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>Nenhuma categoria de receita cadastrada.</p>
<% end %>

<h2>Despesas</h2>

<% if @despesas.any? %>
  <ul>
    <% @despesas.each do |category| %>
      <li>
        <%= category.name %>
        <%= link_to "Editar", edit_category_path(category) %>
        <%= button_to "Excluir", category_path(category), method: :delete, data: { turbo_confirm: "Tem certeza?" } %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>Nenhuma categoria de despesa cadastrada.</p>
<% end %>